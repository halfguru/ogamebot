# OGame account credentials
OGAME_PASSWORD=your_ogame_password_here

# ogamed connection
OGAME_OGAMED_URL=http://ogamed:8080

# ogamed environment (used by ogamed container)
OGAMED_UNIVERSE=s123-en.ogame.gameforge.com
OGAMED_USERNAME=your_username
OGAMED_PASSWORD=your_ogame_password_here
OGAMED_LANGUAGE=en

# Optional: Proxy settings
OGAMED_PROXY=
OGAMED_PROXY_USERNAME=
OGAMED_PROXY_PASSWORD=
OGAMED_PROXY_TYPE=socks5
